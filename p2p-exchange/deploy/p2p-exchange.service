[Unit]
Description=P2P XMR Exchange - Gunicorn Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=p2p
Group=p2p
WorkingDirectory=/var/www/p2p-exchange
EnvironmentFile=/var/www/p2p-exchange/.env
ExecStart=/var/www/p2p-exchange/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 4 \
    --worker-class sync \
    --timeout 120 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    --access-logfile /var/log/p2p-exchange/access.log \
    --error-logfile /var/log/p2p-exchange/error.log \
    --log-level info \
    --pid /var/run/p2p-exchange/gunicorn.pid \
    app.main:app
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/p2p-exchange /var/run/p2p-exchange /var/www/p2p-exchange
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=p2p-exchange

[Install]
WantedBy=multi-user.target
