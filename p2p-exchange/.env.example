# =============================================================================
# P2P Exchange — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Application ----
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-64-char-hex-string
DEBUG=false

# ---- Database ----
# SQLite (development):
DATABASE_URL=sqlite:///p2p_exchange.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/p2p_exchange

# ---- Monero RPC ----
# Comma-separated list of XMR daemon RPC endpoints for redundancy
XMR_RPC_ENDPOINTS=http://node.moneroworld.com:18089,http://xmr-node.cakewallet.com:18081
XMR_RPC_USER=
XMR_RPC_PASSWORD=
# Wallet RPC endpoint (monero-wallet-rpc)
XMR_WALLET_RPC_URL=http://127.0.0.1:18083/json_rpc
XMR_WALLET_RPC_USER=
XMR_WALLET_RPC_PASSWORD=

# ---- Security ----
# HMAC key for session token signing (64 hex chars)
SESSION_HMAC_KEY=change-me-to-a-random-64-char-hex-string
# JWT settings
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# ---- Rate Limiting ----
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_AUTH=20/hour
RATE_LIMIT_TRADES=50/hour

# ---- Escrow ----
# Number of XMR confirmations required before trade proceeds
ESCROW_CONFIRMATIONS_REQUIRED=10
# Escrow timeout in hours — auto-cancel if not completed
ESCROW_TIMEOUT_HOURS=24
# Arbitration bond percentage (of trade amount)
ARBITRATION_BOND_PERCENT=5

# ---- Notifications ----
# SMTP settings (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.onion

# Nostr relay (optional)
NOSTR_RELAY_URL=
NOSTR_PRIVATE_KEY=

# ---- Tor ----
TOR_ENABLED=true
ONION_ADDRESS=

# ---- Apache ----
SERVER_NAME=localhost
SERVER_PORT=80
