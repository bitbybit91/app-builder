SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production
DATABASE_URL=postgresql://p2puser:password@localhost/p2pexchange
DATABASE_URL_DEV=sqlite:///p2p_exchange.db
MONERO_RPC_URL=http://127.0.0.1:18083/json_rpc
MONERO_RPC_USER=rpcuser
MONERO_RPC_PASS=rpcpassword
MONERO_WALLET_ADDRESS=your-monero-wallet-address
ESCROW_TIMEOUT_HOURS=24
TRADE_FEE_PERCENT=0.5
MAX_TRADE_XMR=100.0
MIN_TRADE_XMR=0.01
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
SESSION_LIFETIME_DAYS=30
HMAC_SECRET=your-hmac-secret-change-in-production
ONION_ADDRESS=youraddress.onion
SITE_URL=http://localhost:5000
LOG_LEVEL=INFO
LOG_FILE=/var/log/p2p-exchange/app.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOSTR_PRIVATE_KEY=
MAX_CONTENT_LENGTH=16777216
CORS_ORIGINS=*
WTF_CSRF_ENABLED=True
