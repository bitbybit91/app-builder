# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production

# Database
DATABASE_PATH=/var/lib/p2p-exchange/exchange.db

# Sessions
SESSION_FILE_DIR=/var/lib/p2p-exchange/sessions
SESSION_LIFETIME_DAYS=30

# Monero Wallet RPC
MONERO_RPC_URL=http://127.0.0.1:18082/json_rpc
MONERO_RPC_USER=
MONERO_RPC_PASS=

# CoinGecko cache (seconds)
COINGECKO_CACHE_TTL=300
